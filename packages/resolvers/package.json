{
  "name": "@vtex-us-se/resolvers",
  "version": "0.2.0",
  "description": "Server-only GraphQL resolvers, typeDefs and client query strings for FastStore v4 operations, consumed via the FastStore GraphQL extension convention (src/graphql/<namespace>/{typeDefs,resolvers}).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./b2c": {
      "types": "./dist/b2c/index.d.ts",
      "default": "./dist/b2c/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "b2c": [
        "./dist/b2c/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && copyfiles -u 1 \"src/**/*.{graphql,meta.json}\" dist",
    "lint": "eslint src",
    "test": "echo \"no tests yet\""
  },
  "devDependencies": {
    "@vtex-us-se/config": "workspace:*",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "copyfiles": "^2.4.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
