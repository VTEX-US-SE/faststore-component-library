{
  "name": "@vtex-us-se/ui",
  "version": "0.2.0",
  "description": "Styles and tokens on top of @vtex-us-se/components, with the FastStore v4 CMS schema for each component colocated alongside it.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./b2c": {
      "types": "./dist/b2c/index.d.ts",
      "default": "./dist/b2c/index.js"
    },
    "./b2b": {
      "types": "./dist/b2b/index.d.ts",
      "default": "./dist/b2b/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "b2c": [
        "./dist/b2c/index.d.ts"
      ],
      "b2b": [
        "./dist/b2b/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && copyfiles -u 1 \"src/**/*.{scss,jsonc}\" dist",
    "lint": "eslint src",
    "test": "echo \"no tests yet\""
  },
  "dependencies": {
    "@vtex-us-se/components": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "@faststore/ui": ">=3.99.4 <5",
    "@faststore/components": ">=3.99.4 <5"
  },
  "devDependencies": {
    "@vtex-us-se/config": "workspace:*",
    "@types/react": "^18.3.0",
    "typescript": "^5.6.0",
    "include-media": "^1.4.10",
    "copyfiles": "^2.4.1",
    "@faststore/ui": "^4.7.0",
    "@faststore/components": "^4.7.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
