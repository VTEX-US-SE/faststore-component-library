{
  "$extends": [
    "#/$defs/base-component"
  ],
  "$componentKey": "SeCustomCrossSellingShelf",
  "$componentTitle": "SE Custom Cross-Selling Shelf",
  "title": "Custom Cross Selling Shelf B2B",
  "description": "Cross selling shelf with custom product card",
  "type": "object",
  "required": [
    "title",
    "numberOfItems",
    "kind"
  ],
  "properties": {
    "title": {
      "title": "Title",
      "type": "string"
    },
    "numberOfItems": {
      "title": "Total number of items",
      "type": "integer",
      "default": 5,
      "description": "Total number of items. The quantity may be smaller if the query returns fewer products."
    },
    "kind": {
      "title": "Kind",
      "type": "string",
      "default": "buy",
      "enumNames": [
        "Who bought also bought",
        "Who saw also saw"
      ],
      "enum": [
        "buy",
        "view"
      ],
      "description": "Change cross selling types"
    }
  }
}
