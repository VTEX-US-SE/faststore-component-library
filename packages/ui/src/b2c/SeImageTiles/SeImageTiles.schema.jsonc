{
  "$extends": ["#/$defs/base-component"],
  "$componentKey": "SeImageTiles",
  "$componentTitle": "SE Image Tiles",
  "description": "Displays 2 to 4 large, side-by-side clickable image tiles, each redirecting to its own URL.",
  "type": "object",
  "required": ["tiles"],
  "properties": {
    "captionPosition": {
      "title": "Caption",
      "description": "Show each tile's title and link label below its image.",
      "type": "string",
      "enum": ["none", "below"],
      "enumNames": ["No caption", "Below the image"],
      "default": "none"
    },
    "columns": {
      "title": "Columns",
      "description": "Leave empty to place every tile in one row (stacked on mobile). When set, mobile keeps up to 2 columns.",
      "type": "integer",
      "enum": [2, 3, 4]
    },
    "aspectRatio": {
      "title": "Image aspect ratio",
      "description": "Leave empty for 3:4 on desktop and 4:3 on mobile.",
      "type": "string",
      "enum": ["3:4", "2:3", "4:5", "1:1"]
    },
    "maxWidth": {
      "title": "Max width",
      "description": "Max width of the centered grid, any CSS length (e.g. 880px). Leave empty for the page grid width.",
      "type": "string"
    },
    "tiles": {
      "title": "Image Tiles",
      "description": "Add between 2 and 4 tiles. Each tile is a full clickable image.",
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["src", "url", "alt"],
        "properties": {
          "src": {
            "title": "Image",
            "description": "Image to display",
            "type": "string",
            "widget": {
              "ui:widget": "media-gallery",
              "restrictMediaTypes": {
                "video": true,
                "image": ["png", "jpg", "jpeg", "gif", "svg", "webp"]
              }
            }
          },
          "url": {
            "title": "Link URL",
            "description": "URL to redirect to when the tile is clicked",
            "type": "string"
          },
          "alt": {
            "title": "Alternative Label",
            "description": "Alternative text for accessibility",
            "type": "string"
          },
          "title": {
            "title": "Caption title",
            "description": "Shown below the image when the caption is enabled.",
            "type": "string"
          },
          "linkLabel": {
            "title": "Caption link label",
            "description": "Small label under the title when the caption is enabled.",
            "type": "string",
            "default": "See more"
          }
        }
      }
    }
  },
  "readOnly": false,
  "writeOnly": false,
  "deprecated": false,
  "$abstract": false
}
