{
  "name": "@vtex-us-se/components",
  "version": "0.1.0",
  "description": "Logic and accessibility for React components for FastStore v4, no styles.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./b2c": {
      "types": "./dist/b2c/index.d.ts",
      "default": "./dist/b2c/index.js"
    },
    "./b2b": {
      "types": "./dist/b2b/index.d.ts",
      "default": "./dist/b2b/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "b2c": [
        "./dist/b2c/index.d.ts"
      ],
      "b2b": [
        "./dist/b2b/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "echo \"no tests yet\""
  },
  "dependencies": {
    "sanitize-html": "^2.13.0",
    "@vtex-us-se/resolvers": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "@faststore/core": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "@faststore/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vtex-us-se/config": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/sanitize-html": "^2.13.0",
    "@faststore/core": "^4.4.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
